{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun run ./src/command/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run ./src/command/seed.ts",
    "stock:sync": "bun run ./src/command/stock-sync.ts",
    "make:migration": "bun run ./src/command/make-migration.ts",
    "make:seeder": "bun run ./src/command/make-seeder.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "jose": "^5.4.0",
    "pg": "^8.12.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "bun-types": "^1.1.13",
    "drizzle-kit": "^0.21.4",
    "typescript": "^5.4.5"
  }
}
